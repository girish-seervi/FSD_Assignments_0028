<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Profile - Family Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container">
      <a class="navbar-brand" href="/users">
        <i class="bi bi-people-fill me-2 text-primary"></i>Family Management
      </a>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/users"><i class="bi bi-arrow-left me-1"></i>Back to Users</a>
      </div>
    </div>
  </nav>

  <div class="container mt-4 mb-5">
    
    <div class="row g-4">
      <!-- Profile Card -->
      <div class="col-lg-4">
        <div class="card h-100 border-primary border-opacity-25 border-top border-4">
          <div class="card-body p-4 text-center position-relative">
            <div class="mb-3 mt-3">
              <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle" style="width: 96px; height: 96px; font-size: 2rem; font-weight: bold;">
                <%= user.firstName.charAt(0) %><%= user.lastName.charAt(0) %>
              </div>
            </div>
            <h3 class="fw-bold mb-1"><%= user.firstName %> <%= user.lastName %></h3>
            <p class="text-muted mb-4">Parent Profile</p>
            
            <div class="text-start px-3 py-3 bg-light rounded-4">
              <div class="icon-text mb-3">
                <i class="bi bi-envelope text-primary fs-5"></i>
                <span class="ms-2"><%= user.email %></span>
              </div>
              <div class="icon-text">
                <i class="bi bi-telephone text-primary fs-5"></i>
                <span class="ms-2"><%= user.phone || 'N/A' %></span>
              </div>
            </div>
            
            <div class="mt-4 pt-3 border-top border-light">
              <span class="custom-badge bg-primary bg-opacity-10 text-primary px-3 py-2">
                <i class="bi bi-diagram-3 me-2"></i> <%= children ? children.length : 0 %> Children
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Children Section -->
      <div class="col-lg-8">
        
        <!-- Add Child Form -->
        <%- include('add-child', { userId: user._id }) %>

        <!-- Children List -->
        <div class="d-flex align-items-center justify-content-between mb-3 mt-5">
          <h4 class="fw-bold mb-0">Children Directory</h4>
        </div>

        <div class="row g-3">
          <% if (children && children.length > 0) { %>
            <% children.forEach(child => { %>
              <div class="col-md-6">
                <div class="card h-100 bg-white border border-light">
                  <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                      <div class="d-flex align-items-center gap-3">
                        <div class="bg-info bg-opacity-10 text-info rounded-3 p-2">
                          <i class="bi bi-person-hearts fs-4"></i>
                        </div>
                        <div>
                          <h5 class="fw-bold mb-0"><%= child.firstName %> <%= child.lastName %></h5>
                          <small class="text-muted"><%= child.age %> years old</small>
                        </div>
                      </div>
                    </div>
                    
                    <% if(child.email) { %>
                      <p class="mb-3 text-muted small"><i class="bi bi-envelope me-2"></i><%= child.email %></p>
                    <% } else { %>
                      <p class="mb-3 text-muted small opacity-50"><i class="bi bi-envelope me-2"></i>No email</p>
                    <% } %>
                    
                    <div class="d-flex gap-2 mt-3 pt-3 border-top border-light">
                      <a href="/users/<%= user._id %>/children/<%= child._id %>" class="btn btn-sm btn-light w-100 fw-bold">View</a>
                      <button type="button" class="btn btn-sm btn-outline-warning w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#updateChildModal<%= child._id %>">
                        Edit
                      </button>
                      <form action="/children/<%= child._id %>?_method=DELETE" method="POST" class="w-100" onsubmit="return confirm('Delete this child?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 fw-bold">Delete</button>
                      </form>
                    </div>

                  </div>
                </div>
              </div>

              <!-- Update Child Modal -->
              <div class="modal fade" id="updateChildModal<%= child._id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content border-0 shadow-lg rounded-4">
                    <div class="modal-header bg-light border-0 px-4 py-3">
                      <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2 text-warning"></i>Edit Child Details</h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/children/<%= child._id %>?_method=PATCH" method="POST">
                      <div class="modal-body p-4">
                        <div class="row g-3">
                          <div class="col-6">
                            <label class="form-label fw-bold text-muted small">First Name</label>
                            <input type="text" class="form-control bg-light border-0" name="firstName" value="<%= child.firstName %>">
                          </div>
                          <div class="col-6">
                            <label class="form-label fw-bold text-muted small">Last Name</label>
                            <input type="text" class="form-control bg-light border-0" name="lastName" value="<%= child.lastName %>">
                          </div>
                          <div class="col-6">
                            <label class="form-label fw-bold text-muted small">Age</label>
                            <input type="number" class="form-control bg-light border-0" name="age" value="<%= child.age %>" min="0">
                          </div>
                          <div class="col-6">
                            <label class="form-label fw-bold text-muted small">Email (Optional)</label>
                            <input type="email" class="form-control bg-light border-0" name="email" value="<%= child.email || '' %>">
                          </div>
                        </div>
                      </div>
                      <div class="modal-footer border-0 px-4 pb-4 pt-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Save Changes</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-12">
              <div class="text-center p-5 bg-white rounded-4 shadow-sm border border-light">
                <i class="bi bi-balloon fs-1 text-muted opacity-25 mb-3 d-block"></i>
                <h5 class="text-muted">No children registered yet.</h5>
                <p class="text-muted mb-0 small">Use the form above to add a child to this profile.</p>
              </div>
            </div>
          <% } %>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
