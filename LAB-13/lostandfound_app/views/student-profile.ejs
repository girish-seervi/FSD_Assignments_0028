<%- include('partials/header', { title: student.fullName + ' - Profile', activePage: 'students' }) %>

<div class="page-header">
  <div>
    <h1><%= student.fullName %></h1>
    <p>Student Profile &bull; <%= student.department %></p>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <a href="/students" class="btn btn-secondary">&larr; All Students</a>
    <a href="/lost-items/new" class="btn btn-warning btn-sm">+ Report Lost</a>
    <a href="/found-items/new" class="btn btn-success btn-sm">+ Report Found</a>
  </div>
</div>

<% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <div class="alert alert-success"><%= successMessage %></div>
<% } %>

<div class="details-card" style="margin-bottom: 2.5rem;">
  <h2>Student Information</h2>
  <div class="details-grid">
    <div class="detail-item">
      <dt>Student ID (Database)</dt>
      <dd><code><%= student._id %></code></dd>
    </div>
    <div class="detail-item">
      <dt>College Email</dt>
      <dd><a href="mailto:<%= student.email %>"><%= student.email %></a></dd>
    </div>
    <div class="detail-item">
      <dt>Department</dt>
      <dd><%= student.department %></dd>
    </div>
    <div class="detail-item">
      <dt>Contact Number</dt>
      <dd><a href="tel:<%= student.contactNumber %>"><%= student.contactNumber %></a></dd>
    </div>
    <div class="detail-item">
      <dt>Member Since</dt>
      <dd><%= new Date(student.createdAt).toLocaleDateString() %></dd>
    </div>
  </div>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
  <!-- Lost Items by this student -->
  <div>
    <div class="page-header" style="margin-bottom: 1rem;">
      <h3>Lost Items Reported (<%= lostItems ? lostItems.length : 0 %>)</h3>
    </div>
    <% if (lostItems && lostItems.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% lostItems.forEach(item => { %>
          <div class="card">
            <div class="card-header">
              <a href="/lost-items/<%= item._id %>" class="card-title"><%= item.itemName %></a>
              <span class="badge badge-lost"><%= item.status %></span>
            </div>
            <div class="card-meta">
              <span class="badge badge-category" style="width: fit-content;"><%= item.category %></span>
              <div class="card-meta-row"><strong>Last seen:</strong> <%= item.lastSeenLocation %></div>
              <div class="card-meta-row"><strong>Date lost:</strong> <%= new Date(item.dateLost).toLocaleDateString() %></div>
            </div>
            <p class="card-description"><%= item.description %></p>
            <div class="card-footer">
              <a href="/lost-items/<%= item._id %>" class="btn btn-sm btn-outline">View Details</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No lost items reported by this student.</p>
      </div>
    <% } %>
  </div>

  <!-- Found Items by this student -->
  <div>
    <div class="page-header" style="margin-bottom: 1rem;">
      <h3>Found Items Reported (<%= foundItems ? foundItems.length : 0 %>)</h3>
    </div>
    <% if (foundItems && foundItems.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% foundItems.forEach(item => { %>
          <div class="card">
            <div class="card-header">
              <a href="/found-items/<%= item._id %>" class="card-title"><%= item.itemName %></a>
              <span class="badge badge-found"><%= item.status %></span>
            </div>
            <div class="card-meta">
              <span class="badge badge-category" style="width: fit-content;"><%= item.category %></span>
              <div class="card-meta-row"><strong>Found location:</strong> <%= item.foundLocation %></div>
              <div class="card-meta-row"><strong>Date found:</strong> <%= new Date(item.dateFound).toLocaleDateString() %></div>
            </div>
            <p class="card-description"><%= item.description %></p>
            <div class="card-footer">
              <a href="/found-items/<%= item._id %>" class="btn btn-sm btn-outline">View Details</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No found items reported by this student.</p>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
