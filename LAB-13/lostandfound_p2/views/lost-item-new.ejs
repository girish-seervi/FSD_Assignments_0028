<%- include('partials/header', { title: 'Report Lost Item', activePage: 'lost-items' }) %>

<div class="page-header">
  <div>
    <h1>Report a Lost Item</h1>
    <p>Submit details about an item you lost on campus</p>
  </div>
  <a href="/lost-items" class="btn btn-secondary">&larr; Back to Lost Items</a>
</div>

<% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
  <div class="alert alert-danger"><%= errorMessage %></div>
<% } %>

<% if (!students || students.length === 0) { %>
  <div class="alert alert-danger">
    No student profiles found. You must <a href="/students/new" style="font-weight: 600; text-decoration: underline; margin-left: 4px;">register a student profile</a> before reporting an item.
  </div>
<% } %>

<div class="form-card">
  <form action="/lost-items" method="POST">
    <div class="form-group">
      <label for="itemName">Item Name <span class="required">*</span></label>
      <input type="text" id="itemName" name="itemName" class="form-control" placeholder="e.g. Blue Dell Laptop Charger" value="<%= typeof formData !== 'undefined' && formData.itemName ? formData.itemName : '' %>" required>
    </div>

    <div class="form-group">
      <label for="category">Category <span class="required">*</span></label>
      <select id="category" name="category" class="form-control" required>
        <option value="">Select a category</option>
        <option value="Electronics" <%= typeof formData !== 'undefined' && formData.category === 'Electronics' ? 'selected' : '' %>>Electronics</option>
        <option value="ID Card / Documents" <%= typeof formData !== 'undefined' && formData.category === 'ID Card / Documents' ? 'selected' : '' %>>ID Card / Documents</option>
        <option value="Books / Stationery" <%= typeof formData !== 'undefined' && formData.category === 'Books / Stationery' ? 'selected' : '' %>>Books / Stationery</option>
        <option value="Clothing / Accessories" <%= typeof formData !== 'undefined' && formData.category === 'Clothing / Accessories' ? 'selected' : '' %>>Clothing / Accessories</option>
        <option value="Keys / Wallets" <%= typeof formData !== 'undefined' && formData.category === 'Keys / Wallets' ? 'selected' : '' %>>Keys / Wallets</option>
        <option value="Water Bottle" <%= typeof formData !== 'undefined' && formData.category === 'Water Bottle' ? 'selected' : '' %>>Water Bottle</option>
        <option value="Other" <%= typeof formData !== 'undefined' && formData.category === 'Other' ? 'selected' : '' %>>Other</option>
      </select>
    </div>

    <div class="form-group">
      <label for="description">Detailed Description <span class="required">*</span></label>
      <textarea id="description" name="description" class="form-control" placeholder="Describe the item, color, brand, distinct marks, or stickers..." required><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="lastSeenLocation">Last Seen Location <span class="required">*</span></label>
      <input type="text" id="lastSeenLocation" name="lastSeenLocation" class="form-control" placeholder="e.g. Main Library, 2nd Floor Reading Hall" value="<%= typeof formData !== 'undefined' && formData.lastSeenLocation ? formData.lastSeenLocation : '' %>" required>
    </div>

    <div class="form-group">
      <label for="dateLost">Date Lost <span class="required">*</span></label>
      <input type="date" id="dateLost" name="dateLost" class="form-control" value="<%= typeof formData !== 'undefined' && formData.dateLost ? formData.dateLost : new Date().toISOString().split('T')[0] %>" required>
    </div>

    <div class="form-group">
      <label for="reportedBy">Reporting Student <span class="required">*</span></label>
      <select id="reportedBy" name="reportedBy" class="form-control" required>
        <option value="">Select the student reporting this item</option>
        <% if (students && students.length > 0) { %>
          <% students.forEach(student => { %>
            <option value="<%= student._id %>" <%= typeof formData !== 'undefined' && String(formData.reportedBy) === String(student._id) ? 'selected' : '' %>>
              <%= student.fullName %> (<%= student.email %> - <%= student.department %>)
            </option>
          <% }) %>
        <% } %>
      </select>
      <small style="display: block; margin-top: 0.35rem; color: var(--text-muted);">
        Don't see your name? <a href="/students/new">Register student profile</a>
      </small>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-warning" <%= (!students || students.length === 0) ? 'disabled' : '' %>>Submit Lost Report</button>
      <a href="/lost-items" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
