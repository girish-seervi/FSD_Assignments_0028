<%- include('partials/header', { title: 'Error' }) %>

<div style="max-width: 650px; margin: 3rem auto; text-align: center; padding: 2.5rem 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow);">
  <div style="font-size: 3rem; margin-bottom: 0.5rem;">
    <%= typeof statusCode !== 'undefined' && statusCode === 403 ? '🔒' : '⚠️' %>
  </div>
  <div style="display: inline-block; padding: 0.25rem 0.75rem; background: #fee2e2; color: #991b1b; border-radius: 9999px; font-weight: 700; font-size: 0.85rem; margin-bottom: 1rem;">
    HTTP Error <%= typeof statusCode !== 'undefined' ? statusCode : 500 %>
  </div>
  <h1 style="font-size: 1.5rem; margin-bottom: 0.75rem; color: var(--text-main);">
    <%= typeof title !== 'undefined' ? title : 'Something Went Wrong' %>
  </h1>
  <p style="color: var(--text-muted); margin-bottom: 2rem; font-size: 1rem; line-height: 1.6;">
    <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your request.' %>
  </p>

  <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
    <a href="javascript:history.back()" class="btn btn-outline">&larr; Go Back</a>
    <a href="/" class="btn btn-primary">Return to Dashboard</a>
  </div>
</div>

<%- include('partials/footer') %>
