<%- include('partials/header', { title: '404 - Not Found' }) %>

<div style="text-align: center; padding: 4rem 1rem;">
  <div style="font-size: 5rem; font-weight: 800; color: var(--primary); line-height: 1;">404</div>
  <h1 style="margin: 1rem 0 0.5rem; font-size: 1.75rem;">Page or Resource Not Found</h1>
  <p style="color: var(--text-muted); max-width: 500px; margin: 0 auto 2rem; font-size: 1rem;">
    <%= typeof message !== 'undefined' ? message : 'The student profile, lost item report, found item, or page you are looking for does not exist or has an invalid ID.' %>
  </p>
  <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
    <a href="/" class="btn btn-primary">Go to Dashboard</a>
    <a href="/lost-items" class="btn btn-outline">Browse Lost Items</a>
    <a href="/found-items" class="btn btn-outline">Browse Found Items</a>
    <a href="/claims" class="btn btn-outline">View Claims</a>
  </div>
</div>

<%- include('partials/footer') %>
