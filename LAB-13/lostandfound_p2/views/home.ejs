<%- include('partials/header', { title: 'Dashboard', activePage: 'home' }) %>

<div class="action-banner">
  <div>
    <h2>Campus Lost &amp; Found Management System &bull; Phase 2</h2>
    <p>A full-cycle platform enabling students to report lost belongings, log found items, submit ownership claims, and safely return items under backend ownership verification.</p>
  </div>
  <div class="action-buttons">
    <a href="/lost-items/new" class="btn btn-warning">Report Lost Item</a>
    <a href="/found-items/new" class="btn btn-success">Report Found Item</a>
    <a href="/claims" class="btn btn-outline" style="background: white;">Claims Tracker</a>
    <a href="/students/new" class="btn btn-secondary">Register Student</a>
  </div>
</div>

<!-- Key Phase 2 Metrics -->
<div class="stats-grid-4">
  <div class="metric-card">
    <div class="metric-title">Registered Students</div>
    <div class="metric-value"><%= studentCount %></div>
    <a href="/students" class="metric-link">View all students &rarr;</a>
  </div>
  <div class="metric-card">
    <div class="metric-title">Reported Lost Items</div>
    <div class="metric-value"><%= lostCount %></div>
    <a href="/lost-items" class="metric-link">Browse lost items &rarr;</a>
  </div>
  <div class="metric-card">
    <div class="metric-title">Reported Found Items</div>
    <div class="metric-value"><%= foundCount %></div>
    <a href="/found-items" class="metric-link">Browse found items &rarr;</a>
  </div>
  <div class="metric-card" style="border-top: 3px solid #059669;">
    <div class="metric-title">Items Returned / Total Claims</div>
    <div class="metric-value" style="display: flex; align-items: baseline; gap: 0.5rem;">
      <span><%= returnedCount %></span>
      <span style="font-size: 1rem; color: var(--text-muted); font-weight: normal;">/ <%= claimCount %> claims (<%= pendingCount %> pending)</span>
    </div>
    <a href="/claims" class="metric-link" style="color: #059669;">Review claims &rarr;</a>
  </div>
</div>

<!-- Recent Items & Claims Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
  <!-- Recent Lost Items -->
  <section>
    <div class="page-header" style="margin-bottom: 1rem;">
      <h2 style="font-size: 1.25rem;">Recent Lost Items</h2>
      <a href="/lost-items" class="btn btn-sm btn-outline">View All</a>
    </div>
    <% if (recentLostItems && recentLostItems.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% recentLostItems.forEach(item => { %>
          <div class="card">
            <div class="card-header">
              <a href="/lost-items/<%= item._id %>" class="card-title"><%= item.itemName %></a>
              <span class="badge badge-lost"><%= item.status %></span>
            </div>
            <div class="card-meta">
              <span class="badge badge-category" style="width: fit-content;"><%= item.category %></span>
              <div class="card-meta-row">
                <strong>Last seen:</strong> <%= item.lastSeenLocation %>
              </div>
              <div class="card-meta-row">
                <strong>Date:</strong> <%= new Date(item.dateLost).toLocaleDateString() %>
              </div>
              <% if (item.reportedBy) { %>
                <div class="card-meta-row">
                  <strong>Reported by:</strong> <a href="/students/<%= item.reportedBy._id %>"><%= item.reportedBy.fullName %></a>
                </div>
              <% } %>
            </div>
            <p class="card-description"><%= item.description %></p>
            <div class="card-footer">
              <a href="/lost-items/<%= item._id %>" class="btn btn-sm btn-outline">View Details</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No lost items reported yet.</p>
        <a href="/lost-items/new" class="btn btn-sm btn-warning">Report Lost Item</a>
      </div>
    <% } %>
  </section>

  <!-- Recent Found Items -->
  <section>
    <div class="page-header" style="margin-bottom: 1rem;">
      <h2 style="font-size: 1.25rem;">Recent Found Items</h2>
      <a href="/found-items" class="btn btn-sm btn-outline">View All</a>
    </div>
    <% if (recentFoundItems && recentFoundItems.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% recentFoundItems.forEach(item => { %>
          <div class="card">
            <div class="card-header">
              <a href="/found-items/<%= item._id %>" class="card-title"><%= item.itemName %></a>
              <span class="badge <%= item.status === 'Returned' ? 'badge-returned' : 'badge-found' %>">
                <%= item.status %>
              </span>
            </div>
            <div class="card-meta">
              <span class="badge badge-category" style="width: fit-content;"><%= item.category %></span>
              <div class="card-meta-row">
                <strong>Found at:</strong> <%= item.foundLocation %>
              </div>
              <div class="card-meta-row">
                <strong>Date:</strong> <%= new Date(item.dateFound).toLocaleDateString() %>
              </div>
              <% if (item.reportedBy) { %>
                <div class="card-meta-row">
                  <strong>Found by:</strong> <a href="/students/<%= item.reportedBy._id %>"><%= item.reportedBy.fullName %></a>
                </div>
              <% } %>
            </div>
            <p class="card-description"><%= item.description %></p>
            <div class="card-footer" style="display: flex; justify-content: space-between; align-items: center;">
              <a href="/found-items/<%= item._id %>" class="btn btn-sm btn-outline">
                <%= item.status === 'Returned' ? 'View Details' : 'View & Claim' %>
              </a>
              <% if (item.status === 'Returned') { %>
                <span style="font-size: 0.8rem; color: #059669; font-weight: 600;">✓ Returned</span>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No found items have been reported yet.</p>
        <a href="/found-items/new" class="btn btn-sm btn-success">Report Found Item</a>
      </div>
    <% } %>
  </section>
</div>

<!-- Recent Claims Activity -->
<section style="margin-top: 2.5rem;">
  <div class="page-header" style="margin-bottom: 1rem;">
    <div>
      <h2 style="font-size: 1.25rem;">Recent Claims Activity (Phase 2 Workflow)</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Live claim status updates and resolutions across campus</p>
    </div>
    <a href="/claims" class="btn btn-sm btn-outline">View All Claims</a>
  </div>
  <% if (recentClaims && recentClaims.length > 0) { %>
    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <% recentClaims.forEach(claim => { %>
        <div class="claim-card">
          <div class="claim-card-header">
            <div>
              <strong>Claim for:</strong> 
              <% if (claim.foundItemId) { %>
                <a href="/found-items/<%= claim.foundItemId._id %>" style="font-weight: 600; color: var(--primary);">
                  <%= claim.foundItemId.itemName %>
                </a>
              <% } else { %>
                <span style="color: var(--text-muted);">[Item Removed]</span>
              <% } %>
            </div>
            <span class="badge <%= claim.status === 'Approved' ? 'badge-approved' : (claim.status === 'Rejected' ? 'badge-rejected' : 'badge-pending') %>">
              <%= claim.status %>
            </span>
          </div>
          <div style="font-size: 0.9rem; color: var(--text-muted); display: flex; gap: 1.5rem; flex-wrap: wrap;">
            <div>
              <strong>Claimant:</strong> 
              <% if (claim.claimedBy) { %>
                <a href="/students/<%= claim.claimedBy._id %>"><%= claim.claimedBy.fullName %></a> (<%= claim.claimedBy.department %>)
              <% } else { %>
                [Unknown Student]
              <% } %>
            </div>
            <div>
              <strong>Submitted:</strong> <%= new Date(claim.createdAt).toLocaleDateString() %>
            </div>
          </div>
          <div class="claim-reason-box">
            "<%= claim.reason %>"
          </div>
          <% if (claim.foundItemId) { %>
            <div style="text-align: right;">
              <a href="/found-items/<%= claim.foundItemId._id %>" class="btn btn-sm btn-outline">Open Item &amp; Review Claims &rarr;</a>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <p>No claims submitted yet. Claims will appear here once students submit ownership requests for found items.</p>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
